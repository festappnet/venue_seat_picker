{
  "name": "@festapp/venue-layout",
  "version": "0.3.7",
  "description": "Venue Layout: a portable SVG venue viewer and seat picker powered by a shared Dart geometry kernel",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./kernel": {
      "types": "./src/kernel.d.ts",
      "default": "./dist/venue_layout_kernel.js"
    },
    "./document-schema": "./dist/layout-v2.schema.json"
  },
  "files": [
    "src",
    "dist/venue_layout_kernel.js",
    "dist/demo.js",
    "dist/manifest.json",
    "dist/layout-v2.schema.json",
    "demo",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "build": "../tool/build_web.sh",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": "https://github.com/festappnet/venue_seat_picker",
  "devDependencies": {
    "playwright": "^1.55.0",
    "esbuild": "^0.25.0"
  },
  "homepage": "https://festappnet.github.io/venue_seat_picker/",
  "keywords": [
    "venue-layout",
    "seating-chart",
    "seat-picker",
    "svg"
  ]
}
